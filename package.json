{
  "name": "opencode-tps-meter",
  "version": "0.3.0",
  "description": "Live tokens-per-second meter for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChiR24/opencode-tps-meter.git"
  },
  "homepage": "https://github.com/ChiR24/opencode-tps-meter#readme",
  "bugs": "https://github.com/ChiR24/opencode-tps-meter/issues",
  "dependencies": {
    "@opentui/solid": "^0.3.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.13",
    "@opentui/core": "^0.3.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.13"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "tokens"
  ],
  "license": "MIT"
}
